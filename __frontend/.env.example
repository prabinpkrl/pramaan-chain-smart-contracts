# PramaanChain React frontend
#
# All VITE_* values are public browser configuration. Never place a private
# key, seed phrase, credentialed RPC URL, encryption key, or API secret here.
# Copy to `__frontend/.env` and restart Vite after changing a value.

# REQUIRED for an independent deployment.
# Without this override, the code falls back to the original shared contract.
VITE_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_PRAMAAN_CHAIN_ADDRESS

# OPTIONAL: local-development defaults are shown.
VITE_APP_API_URL=http://localhost:4000/api
VITE_BLOCKCHAIN_API_URL=http://localhost:3000/api
VITE_CHAIN_ID=11155111
VITE_ETHERSCAN_BASE_URL=https://sepolia.etherscan.io
VITE_PUBLIC_APP_URL=http://localhost:5173

# CONDITIONALLY REQUIRED for WalletConnect mobile QR login.
# Leave blank when using browser-extension wallets only.
VITE_WALLETCONNECT_PROJECT_ID=
