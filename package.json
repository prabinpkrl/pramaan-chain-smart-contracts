{
  "name": "pramaan-chain-blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "Local Hardhat environment for the PramaanChain smart contract.",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "local:node": "hardhat node",
    "local:deploy": "hardhat run scripts/deploy.js --network localhost",
    "local:demo": "hardhat run scripts/demo.js --network localhost",
    "clean": "hardhat clean"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "hardhat": "3.10.0"
  }
}
