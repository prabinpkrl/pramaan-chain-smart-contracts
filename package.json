{
  "name": "pramaan-chain-blockchain",
  "version": "0.1.0",
  "private": true,
  "description": "Local Hardhat environment for the PramaanChain smart contract.",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "local:node": "hardhat node",
    "local:deploy": "hardhat run scripts/deploy.js --network localhost",
    "local:demo": "hardhat run scripts/demo.js --network localhost",
    "sepolia:deploy-authorize": "hardhat run scripts/deploy-and-authorize.js --network sepolia --build-profile production",
    "sepolia:resume-authorize": "hardhat run scripts/resume-authorization.js --network sepolia --build-profile production",
    "sepolia:deploy-demo": "hardhat run scripts/demo.js --network sepolia --build-profile production",
    "sepolia:verify": "hardhat verify etherscan --network sepolia --build-profile production",
    "docker:deploy": "node scripts/docker-deploy.js",
    "docker:configure-existing": "node scripts/configure-existing.js",
    "docker:export-deployment": "node scripts/export-deployment.js",
    "clean": "hardhat clean"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "dotenv": "^17.4.2",
    "hardhat": "3.10.0"
  }
}
