# PramaanChain Docker configuration
#
# Copy this file to `.env`. Docker Compose loads that file automatically.
# The copied file is ignored by Git.
# Never place wallet private keys here; the deployment profile uses Hardhat's
# encrypted keystore volume.

# REQUIRED by deployment tools and both long-running backends.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example

# Public browser origin and local port defaults.
PUBLIC_APP_URL=http://localhost:5173
SIWE_DOMAIN=localhost:5173
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
GATEWAY_PORT=3000
APP_BACKEND_PORT=4000
COOKIE_SECURE=false

# OPTIONAL public WalletConnect/Reown project identifier.
VITE_WALLETCONNECT_PROJECT_ID=

# REQUIRED by deployment/import tooling: the exact full commit to build from
# the remote Git repository and record in deployment evidence.
SOURCE_COMMIT=REPLACE_WITH_FULL_40_CHARACTER_GIT_COMMIT_SHA

# SAFETY: keep false for normal operation.
# Set true only when deliberately replacing an existing generated deployment.
ALLOW_NEW_DEPLOYMENT=false
ALLOW_RUNTIME_OVERWRITE=false

# REQUIRED only by the read-only existing-deployment import command.
IMPORT_CONTRACT_ADDRESS=
IMPORT_DEPLOYMENT_BLOCK=
IMPORT_ADMINISTRATOR_ADDRESS=
