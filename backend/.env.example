# PramaanChain public blockchain gateway
#
# Copy to `backend/.env`, replace every REQUIRED placeholder, and never commit
# the copied file. The browser-wallet application uses this gateway read-only.

# REQUIRED: the independently deployed Sepolia contract.
PRAMAAN_CHAIN_ADDRESS=0xYOUR_DEPLOYED_PRAMAAN_CHAIN_ADDRESS

# REQUIRED: exact deployment block reported by `sepolia:deploy-demo`.
# Event indexing starts here; using the original project's block is incorrect.
PRAMAAN_CHAIN_START_BLOCK=YOUR_DEPLOYMENT_BLOCK_NUMBER

# REQUIRED: server-side Sepolia RPC URL.
# Historical event views require eth_getLogs support from the deployment block.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example

# REQUIRED for browser access. Add comma-separated origins when needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OPTIONAL: defaults are shown.
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_CONFIRMATIONS=2
RPC_REQUEST_TIMEOUT_MS=30000
TRANSACTION_WAIT_TIMEOUT_MS=180000
EVENT_QUERY_CHUNK_SIZE=10000
EVENT_MAX_RANGE=100000
INDEX_POLL_INTERVAL_MS=15000
INDEX_MAX_RETRY_INTERVAL_MS=300000
IDEMPOTENCY_STORE_PATH=.data/idempotency.json
TRUST_PROXY=false
PORT=3000

# CONDITIONALLY REQUIRED only for optional server-side gateway writes.
# Keep all three blank for the React browser-wallet application.
ISSUER_ADDRESS=
ISSUER_PRIVATE_KEY=
WRITE_API_KEY=
