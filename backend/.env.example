# PramaanChain Backend Configuration
# Copy to .env and fill in values. Never commit .env.

# Network
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111

# Contract
PRAMAAN_CHAIN_ADDRESS=0x0bb21729BBDaBe54A289A1e924941F8F635Cab84
PRAMAAN_CHAIN_START_BLOCK=11318772

# RPC
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example

# Issuer (write service only — never expose this)
ISSUER_PRIVATE_KEY=0xYOUR_TEST_ONLY_ISSUER_PRIVATE_KEY

# Confirmations before treating a write as final
BLOCKCHAIN_CONFIRMATIONS=2

# Server
PORT=3000
