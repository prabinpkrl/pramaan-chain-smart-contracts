# PramaanChain private application backend
#
# Copy to `app-backend/.env`, replace every REQUIRED placeholder, and never
# commit the copied file. No wallet private key belongs in this service.

# REQUIRED: new random 32-byte value encoded as base64.
# Generate one as documented in docs/demo.md. Do not reuse a wallet key.
APP_DATA_ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_APPLICATION_ENCRYPTION_KEY

# REQUIRED: server-side Sepolia RPC and independently deployed contract.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
PRAMAAN_CHAIN_ADDRESS=0xYOUR_DEPLOYED_PRAMAAN_CHAIN_ADDRESS

# OPTIONAL: local-development defaults are shown.
PORT=4000
APP_ORIGIN=http://localhost:5173
SIWE_DOMAIN=localhost:5173
DATABASE_PATH=.data/pramaan-app.sqlite
BLOCKCHAIN_CHAIN_ID=11155111
COOKIE_SECURE=false
