# PramaanChain contract deployment configuration
#
# This file is an OPTIONAL plaintext fallback.
# Recommended local secret storage:
#   npx hardhat keystore set <VARIABLE_NAME>
#
# If you use this fallback:
#   1. copy this file to `.env`;
#   2. replace the placeholders in `.env`; and
#   3. never commit or share `.env`.

# REQUIRED for `npm run sepolia:deploy` and the optional
# `npm run sepolia:deploy-demo`.
# Private or rate-limited Sepolia RPC endpoints must remain server-side.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example

# REQUIRED for `npm run sepolia:deploy`.
# Use a dedicated, test-only administrator account. Include the 0x prefix.
DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_ONLY_ADMINISTRATOR_PRIVATE_KEY

# REQUIRED only for the optional `npm run sepolia:deploy-demo` four-transaction
# lifecycle. It is not required by Docker deployment or application startup.
ISSUER_PRIVATE_KEY=0xYOUR_TEST_ONLY_ISSUER_PRIVATE_KEY

# REQUIRED only for `npm run sepolia:verify -- <address>`.
# It is not needed for compilation, tests, or deployment.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# OPTIONAL public integration values.
# They are not read by the deployment lifecycle. Fill them from the successful
# deployment output when using scripts/index.js or preparing service configs.
BLOCKCHAIN_CHAIN_ID=11155111
PRAMAAN_CHAIN_ADDRESS=0xYOUR_DEPLOYED_PRAMAAN_CHAIN_ADDRESS
ISSUER_ADDRESS=0xOPTIONAL_LEGACY_ISSUER_ADDRESS
